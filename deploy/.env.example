# Copie para .env (nunca versionar). Valores abaixo sao exemplos.
DB_PASSWORD=troque-por-senha-forte
# true em producao (HTTPS). Para testar em http://localhost use false.
COOKIE_SECURE=false
WEB_PORT=8080
# Primeira socia: usada somente se o banco nao tiver usuarios. Senha com 12+ caracteres.
BOOTSTRAP_SOCIA_NOME=
BOOTSTRAP_SOCIA_EMAIL=
BOOTSTRAP_SOCIA_SENHA=
