# Copie para .env (nunca versionar). Valores abaixo sao exemplos.
DB_PASSWORD=troque-por-senha-forte
# true em producao (HTTPS). Para testar em http://localhost use false.
COOKIE_SECURE=false
WEB_PORT=8081
# HTTPS (perfil https): dominio publico, ex.: 1-2-3-4.sslip.io ou app.seudominio.com.br
DOMINIO=
# Heap da JVM (em VM de 1 GB use -Xmx256m)
JAVA_OPTS=-Xmx384m
# Primeira socia: usada somente se o banco nao tiver usuarios. Senha com 12+ caracteres.
BOOTSTRAP_SOCIA_NOME=
BOOTSTRAP_SOCIA_EMAIL=
BOOTSTRAP_SOCIA_SENHA=
# Rotinas diarias (true so depois de configurar OABs, filtros e SMTP). Assumem UMA instancia do backend.
APP_CAPTURA_AGENDADA=false
APP_ALERTAS_AGENDADO=false
# Timbre dos PDFs (opcional)
APP_ESCRITORIO_ENDERECO=
APP_ESCRITORIO_CONTATO=
# SMTP (alertas e envio de relatorios): ao escolher o provedor, acrescentar SPRING_MAIL_HOST, SPRING_MAIL_PORT,
# SPRING_MAIL_USERNAME, SPRING_MAIL_PASSWORD e APP_ALERTAS_REMETENTE ao servico backend do compose.
# NAO declare SPRING_MAIL_HOST vazio: a presenca da propriedade liga o envio.

# Conexao Google (Gmail e Drive). Valores reais so neste .env da VM (permissao 600); nunca no Git nem no chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.crispimcamposadvogados.com.br/api/google/callback
# gerar com: openssl rand -base64 32 (guarde uma copia no cofre: se perder, todos reconectam)
GOOGLE_TOKEN_KEY=
# Drive: ID e o trecho final da URL da pasta/arquivo (drive.google.com/drive/folders/<ID>)
IMPORTACAO_PASTA_CLIENTES_ID=
IMPORTACAO_PLANILHA_ID=
